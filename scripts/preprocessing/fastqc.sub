container_image = file:///projects/bacteriology_tran_data/apptainer/preprocessing.sif
executable = fastqc.sh

transfer_input_files = fastqc.sh

arguments = $(sample)

environment = "STAGING=$ENV(STAGING)"

log = logs/fastqc_$(cluster)_$(process).log
error = logs/fastqc_$(cluster)_$(process).err
output = logs/fastqc_$(cluster)_$(process).out

requirements = (HasCHTCStaging == true) && (HasCHTCProjects == true)

request_cpus = 8
request_memory = 10GB
request_disk = 10GB      

queue sample from sample_list.txt
