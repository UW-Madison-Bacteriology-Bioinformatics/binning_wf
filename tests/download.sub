executable              = download.sh
arguments               = $(link)

# File transfer settings (useful when nodes do not share a filesystem)#
#should_transfer_files   = YES
#when_to_transfer_output = ON_EXIT
#transfer_input_files    = data.csv, helper_functions.py

# Standard output, error, and HTCondor event log paths
output                  = logs/job_$(Cluster)_$(Process).out
error                   = logs/job_$(Cluster)_$(Process).err
log                     = logs/job_$(Cluster).log

# Resource requests
request_cpus            = 1
request_memory          = 2 GB
request_disk            = 10 GB

# Submit 1 instance of the job
